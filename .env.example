# Copy this file to .env and fill in the values before going live.

# Where appointment requests are sent (POST, JSON).
# WITHOUT THIS, THE APPOINTMENT FORM RUNS IN DEMO MODE AND REQUESTS GO NOWHERE.
VITE_APPOINTMENTS_API_URL=

# Optional: load doctors from an API instead of src/data/doctors.json
VITE_DOCTORS_API_URL=

# Used by scripts/generate-sitemap.mjs (defaults to https://www.ekdanthospital.com)
SITE_URL=
